{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/gate-nudge.py\"",
            "timeout": 5,
            "description": "Nudge toward `z gate` on build-intent prompts when no spec card exists (advisory, non-blocking)."
          }
        ]
      }
    ]
  }
}
