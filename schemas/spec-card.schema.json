{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bekurin/Z/schemas/spec-card.schema.json",
  "title": "Clarity Gate Spec Card",
  "description": "An immutable, frozen specification emitted when the Clarity Gate passes (ambiguity <= 0.2). Never edited in place; a superseding card references its parent via parent_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "parent_id",
    "mode",
    "goal",
    "constraints",
    "success_criteria",
    "non_goals",
    "assumptions",
    "open_questions",
    "ambiguity",
    "created_at",
    "content_hash",
    "frozen"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable id: '<kebab-slug-of-goal>-<UTC-compact-timestamp>', e.g. add-csv-export-20260730T142210Z.",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{8}T[0-9]{6}Z$"
    },
    "parent_id": {
      "type": ["string", "null"],
      "description": "The id of the card this one supersedes, or null for a root card."
    },
    "mode": {
      "type": "string",
      "enum": ["greenfield", "brownfield"]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "The single concrete outcome that must exist when this is done."
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Stack, scope boundaries, budget/time limits, non-negotiables, interfaces."
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "description": "Verifiable acceptance criteria. Each must be objectively checkable.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "verify"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC[0-9]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "verify": {
            "type": "string",
            "minLength": 1,
            "description": "How to check it: a command, a number, or a user action with expected result."
          }
        }
      }
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Explicitly out of scope."
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Stated assumptions the human confirmed — not invented gap-fillers."
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Remaining questions. Must contain no blocking items for a passing card."
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "threshold", "dimensions", "forced"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "1 - sum(weight*clarity) over dimensions."
        },
        "threshold": { "type": "number", "const": 0.2 },
        "forced": {
          "type": "boolean",
          "description": "True if the human forced a pass while score > threshold."
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["goal", "constraint", "success"],
          "properties": {
            "goal": { "$ref": "#/definitions/dimension" },
            "constraint": { "$ref": "#/definitions/dimension" },
            "success": { "$ref": "#/definitions/dimension" },
            "context": { "$ref": "#/definitions/dimension" }
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "sha256 of the canonicalized card with content_hash blanked. Detects tampering with a frozen card."
    },
    "frozen": { "type": "boolean", "const": true }
  },
  "definitions": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight", "clarity"],
      "properties": {
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "clarity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
